rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function noteAccessId(noteId, uid) {
      return noteId + "_" + uid;
    }

    function noteAccessPath(noteId, uid) {
      return /databases/$(database)/documents/noteAccess/$(noteAccessId(noteId, uid));
    }

    function hasNoteAccess(noteId) {
      return signedIn() && exists(noteAccessPath(noteId, request.auth.uid));
    }

    function noteAccessRole(noteId) {
      return get(noteAccessPath(noteId, request.auth.uid)).data.role;
    }

    function isNoteOwner(noteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/notes/$(noteId))
        && get(/databases/$(database)/documents/notes/$(noteId)).data.owner == request.auth.uid;
    }

    function canConverseOnNote(noteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/notes/$(noteId))
        && (
          get(/databases/$(database)/documents/notes/$(noteId)).data.owner == request.auth.uid
          || hasNoteAccess(noteId)
        );
    }

    function conversationNoteId(conversationId) {
      return get(/databases/$(database)/documents/noteConversations/$(conversationId)).data.noteId;
    }

    function canReadConversation(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/noteConversations/$(conversationId))
        && canConverseOnNote(conversationNoteId(conversationId));
    }

    function canDeleteExistingConversation(noteId, createdBy) {
      return signedIn()
        && (
          createdBy == request.auth.uid
          || isNoteOwner(noteId)
        );
    }

    function canDeleteConversation(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/noteConversations/$(conversationId))
        && canDeleteExistingConversation(
          conversationNoteId(conversationId),
          get(/databases/$(database)/documents/noteConversations/$(conversationId)).data.createdBy
        );
    }

    function hasValidMessageThumbs(data) {
      return !data.keys().hasAny(["thumbsUp"])
        || (data.thumbsUp is map);
    }

    function messageThumbs(data) {
      return (data.keys().hasAny(["thumbsUp"]) && data.thumbsUp is map)
        ? data.thumbsUp
        : {};
    }

    function validMessageThumbUpdate(conversationId) {
      return canReadConversation(conversationId)
        && hasValidMessageThumbs(resource.data)
        && hasValidMessageThumbs(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(["thumbsUp"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "thumbsUp",
          "modifiedIso",
          "modified"
        ])
        && messageThumbs(request.resource.data).diff(messageThumbs(resource.data)).affectedKeys().hasOnly([request.auth.uid])
        && (
          !messageThumbs(request.resource.data).keys().hasAny([request.auth.uid])
          || messageThumbs(request.resource.data)[request.auth.uid] == true
        );
    }

    function ownsProfileEmail(emailId) {
      return signedIn()
        && exists(/databases/$(database)/documents/profileEmails/$(emailId))
        && get(/databases/$(database)/documents/profileEmails/$(emailId)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower is string;

      allow update: if isSelf(uid)
        && (!("uid" in resource.data) || request.resource.data.uid == resource.data.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emailLower is string;

      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && request.resource.data.uid == friendUid;

        allow delete: if isSelf(uid);
      }
    }

    match /profileEmails/{emailId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && id == request.resource.data.fromUid + "_" + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && resource.data.status == "pending"
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status in ["accepted", "rejected"];

      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /profileShares/{uid}/items/{itemId} {
      allow read: if isSelf(uid);

      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && (
          request.resource.data.recipientUid == uid
          || request.resource.data.toUid == uid
        );

      allow delete: if signedIn()
        && (
          request.auth.uid == uid
          || resource.data.fromUid == request.auth.uid
        );
    }

    match /profileEmailShares/{emailId}/items/{itemId} {
      allow read: if ownsProfileEmail(emailId);

      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid;

      allow delete: if signedIn()
        && (
          ownsProfileEmail(emailId)
          || resource.data.fromUid == request.auth.uid
        );
    }

    match /notes/{noteId} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.owner == request.auth.uid
          || resource.data.public == true
          || hasNoteAccess(noteId)
        );

      allow update: if signedIn()
        && request.resource.data.owner == resource.data.owner
        && (
          resource.data.owner == request.auth.uid
          || (
            hasNoteAccess(noteId)
            && noteAccessRole(noteId) == "editor"
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(["title", "content", "modified"])
          )
        );

      allow delete: if signedIn()
        && resource.data.owner == request.auth.uid;
    }

    match /folders/{folderId} {
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.owner == request.auth.uid
          || resource.data.public == true
        );

      allow update, delete: if signedIn()
        && resource.data.owner == request.auth.uid;
    }

    match /noteAccess/{accessId} {
      allow read: if signedIn()
        && (
          resource.data.userUid == request.auth.uid
          || resource.data.grantedBy == request.auth.uid
          || isNoteOwner(resource.data.noteId)
        );

      allow create: if signedIn()
        && request.resource.data.role == "editor"
        && request.resource.data.grantedBy == request.auth.uid
        && isNoteOwner(request.resource.data.noteId)
        && accessId == request.resource.data.noteId + "_" + request.resource.data.userUid
        && request.resource.data.userUid != request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.role == "editor"
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.grantedBy == resource.data.grantedBy
        && isNoteOwner(resource.data.noteId)
        && accessId == resource.data.noteId + "_" + resource.data.userUid;

      allow delete: if signedIn()
        && isNoteOwner(resource.data.noteId);
    }

    match /noteConversations/{conversationId} {
      allow read: if canConverseOnNote(resource.data.noteId);

      allow create: if canConverseOnNote(request.resource.data.noteId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.noteId is string;

      allow update: if canConverseOnNote(resource.data.noteId)
        && request.resource.data.noteId == resource.data.noteId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "noteTitle",
          "lastMessagePreview",
          "lastMessageBy",
          "lastMessageAtIso",
          "lastMessageAt",
          "modifiedIso",
          "modified",
          "resolved"
        ]);

      allow delete: if canDeleteExistingConversation(resource.data.noteId, resource.data.createdBy);

      match /messages/{messageId} {
        allow read: if canReadConversation(conversationId)
          || canDeleteConversation(conversationId);

        allow create: if canReadConversation(conversationId)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.noteId == conversationNoteId(conversationId);

        allow update: if validMessageThumbUpdate(conversationId);

        allow delete: if canDeleteConversation(conversationId);
      }
    }
  }
}
